// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table vps_records (name:string, state:string, status:string, cpu_percent:real, ram_percent:real, ram_available_mb:real, event_id:string) 
.create-merge table saltos_table (COUNT_All:long, Window_End_Time:datetime) 
.create-merge table instantanea_tabla (COUNT_All:long, Window_End_Time:datetime) 
.create-merge table salto_table (COUNT_All:long, Window_End_Time:datetime) 
.create-merge table sesion_table (COUNT_All:long, Window_End_Time:datetime) 
.create-merge table stream_cpu_asus (host:string, cpu_percent:real, memory_percent:real, disk_percent:real, gpu_temperature_c:real, timestamp:string) 
.create-merge table e015_website_visits (visit_id:string, visit_timestamp:datetime, page:string) 
.create-or-alter function with (skipvalidation = "true") get_daily_visits_per_page(pageName:string) {
    e015_website_visits
    | where page  == pageName
    | extend visit_day = bin(visit_timestamp, 1d)
    | summarize visit_count = count() by visit_day
}
.create-or-alter materialized-view with (DocString = "Daily website visits without backfill")  e015_mv_daily_web_visits_no_backfill on table e015_website_visits { e015_website_visits
    | extend visit_day = bin(visit_timestamp, 1d)
    | summarize visit_count = count() by visit_day }
.create-or-alter materialized-view with (DocString = "Daily visits with backfill")  e015_mv_daily_web_visits_with_backfill on table e015_website_visits { e015_website_visits
    | extend visit_day = bin(visit_timestamp, 1d)
    | summarize  visit_count = count() by visit_day }
